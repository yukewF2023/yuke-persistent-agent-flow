{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuke-persistent-agent-flow",
  // personal account (yuke@deep.space) — the login also spans a second account
  "account_id": "5213085a6e2cf0a09722c16ca2681648",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Non-secret config. The /goals editor commits GOALS.md to this repo and branch (the one the manager routine clones).
  // SEARCH_GATEWAY_URL: the agent-board app's research gateway, which runs `listen` sessions' searches (src/search.ts);
  // local smoke runs override it with `--var SEARCH_GATEWAY_URL:http://127.0.0.1:8799` (scripts/smoke.sh starts a stub there).
  "vars": { "GITHUB_REPO": "yukewF2023/yuke-persistent-agent-flow", "GITHUB_BRANCH": "main", "SEARCH_GATEWAY_URL": "https://agent-board.app.space/api/research" },

  // The task board: one SQLite-backed Durable Object ("main").
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UptimeAgent", "WeekendScoutAgent", "TeamState"] },
    // v2 (2026-09-23): the worklist agents are gone; their data is deleted with the classes.
    { "tag": "v2", "deleted_classes": ["UptimeAgent", "WeekendScoutAgent", "TeamState"], "new_sqlite_classes": ["Board"] }
  ]
  // Secrets (wrangler secret put): ORCHESTRATOR_TOKEN (manager), WORKER_TOKEN (workers);
  // optional GITHUB_TOKEN (fine-grained PAT, contents read/write, for the /goals editor) and
  // MANAGER_FIRE_URL + MANAGER_FIRE_TOKEN (the routine's API trigger, for the wake button) and
  // BUILDER_FIRE_URL + BUILDER_FIRE_TOKEN (the project builder routine's API trigger; approving an idea fires it);
  // BACKUP_TOKEN (the VM's nightly export), SEARCH_KEY_SECRET (signs per-task search keys) and SEARCH_GATEWAY_TOKEN
  // (the agent-board app's secret of the same name), all three generated by `npm run setup:env`.
}
