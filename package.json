{
  "name": "yuke-persistent-agent-flow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A task board on Cloudflare where a Claude manager plans and reviews work and two DeepSeek V4.1 Flash workers (opencode on a small VM) execute it.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "setup:env": "node scripts/setup-env.mjs",
    "secrets:push": "wrangler secret bulk .dev.vars",
    "tail": "wrangler tail --format pretty"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.2"
  }
}
