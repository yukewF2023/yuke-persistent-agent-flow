[Unit]
Description=Agent board worker %i (opencode + DeepSeek V4.1 Flash)
After=network-online.target
Wants=network-online.target

[Service]
User=agent
Group=agent
EnvironmentFile=/etc/agent-worker.env
# optional per-worker settings, e.g. WORKER_GOALS=F (written by install.sh from WORKER_GOALS_<n> in agent-worker.env)
EnvironmentFile=-/etc/agent-worker-%i.env
Environment=WORKER_ID=%H-%i
Environment=HOME=/home/agent
# each worker has its own opencode data dir (sessions + SQLite) so concurrent workers never share a database
Environment=XDG_DATA_HOME=/srv/agent/xdg-%i
Environment=OPENCODE_SERVER_URL=http://127.0.0.1:409%i
Environment=WORK_ROOT=/srv/work
Environment=TEMPLATES=/srv/templates
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/work
# an execute-only copy of node (install.sh): the worker process is non-dumpable, so sessions cannot read its environment
ExecStart=/srv/agent/node-noread /srv/agent/worker.mjs %i
Restart=always
RestartSec=15
TimeoutStopSec=90
KillMode=mixed
MemoryMax=700M
# the board's backups are not for the sessions (they are root-only as well; this hides the directory altogether)
InaccessiblePaths=-/srv/backups
Nice=5

[Install]
WantedBy=multi-user.target
