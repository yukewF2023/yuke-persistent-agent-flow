[Unit]
Description=opencode web UI (read-only view of worker sessions on 127.0.0.1:4096)
After=network-online.target

[Service]
User=agent
Group=agent
Environment=HOME=/home/agent
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=OPENCODE_DISABLE_AUTOUPDATE=1
ExecStart=/usr/bin/opencode serve --port 4096 --hostname 127.0.0.1
Restart=always
RestartSec=10
MemoryMax=300M
Nice=10

[Install]
WantedBy=multi-user.target
